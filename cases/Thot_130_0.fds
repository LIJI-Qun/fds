simpsimpT_400_0.fds

&HEAD CHID='Thot_130_0', TITLE='Thot_130_0'/
&TIME T_END=60.0/ 
&DUMP DT_DEVC=0.2,  DT_RESTART=30.0,WRITE_XYZ=.TRUE., DT_SLCF=0.2/

&MESH ID='Mesh01', IJK=100,1,100, XB=0.0,0.1,0.0,0.001,0.0,0.1/
&MISC TMPA=30.0,GVEC=0.0,0.0,-9.81/
&RADI RADIATION=.FALSE. /

&DEVC ID='THCP01', QUANTITY='THERMOCOUPLE', XYZ=0.001,0.0005,0.01/
