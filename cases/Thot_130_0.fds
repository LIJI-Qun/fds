! --- 边界条件定义 ---
! 定义左右两侧的等温表面 (单位：摄氏度)
&SURF ID='HOT_WALL',TMP_FRONT=130.0,COLOR='RED' /
&SURF ID='COLD_WALL',TMP_FRONT=30.0,COLOR='BLUE' /
&SURF ID='ADIABATIC_WALL',ADIABATIC=.TRUE.,COLOR='GRAY' /  

!--------- 计算域边界条件 ---------
! 左侧壁 (X=0) 等温加热
&VENT ID='HOT_W',XB=0.0,0.0,0.0,0.001,0.0,0.1,SURF_ID='HOT_WALL' /
! 右侧壁 (X=0.1) 等温冷却
&VENT ID='COLD_W',XB=0.1,0.1,0.0,0.001,0.0,0.1,SURF_ID='COLD_WALL' /
! 下壁 (Z=0) 绝热
&VENT ID='ADIABATIC_DOW',XB=0.0,0.1,0.0,0.001,0.0,0.0,SURF_ID='ADIABATIC_WALL' /
! 上壁 (Z=0.1) 绝热
&VENT ID='ADIABATIC_UPW',XB=0.0,0.1,0.0,0.001,0.1,0.1,SURF_ID='ADIABATIC_WALL' /


! --- 数据输出设置 ---
! 提取中心截面 (Y=0) 的温度场和速度场

&SLCF QUANTITY='TEMPERATURE', ID='SliceT', PBY=0.05/
&SLCF QUANTITY='U-VELOCITY', ID='SliceU', PBY=0.05/
&SLCF QUANTITY='V-VELOCITY', ID='silceV', PBY=0.05/
&SLCF QUANTITY='W-VELOCITY', ID='silce02W', PBY=0.05/
&SLCF QUANTITY='VELOCITY', PBY=0.05 /

