    {  
      "name": "FDS-6.10 Debug",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\Build\\impi_intel_win_db\\fds_impi_intel_win_db.exe",
      "args": ["E:/2CODE/AaaaaIi/4FireFDS/2firePDE/4Back/hrr_2080_0.fds"],
      "stopAtEntry": false,
      "cwd": "E:/2CODE/AaaaaIi/4FireFDS/2firePDE/4Back",
      "environment": [
                // 将 Conda 路径加入 PATH，让 FDS 启动时能找到 python3x.dll
                {
                    "name": "PATH",
                    "value": "E:\\ProgramData\\miniconda3\\envs\\torch2_env;E:\\ProgramData\\miniconda3\\envs\\torch2_env\\Library\\bin;E:\\ProgramData\\miniconda3\\envs\\torch2_env\\Scripts;${env:PATH}"
                },
                // Python 解释器去哪里找标准库 
                {
                    "name": "PYTHONHOME",
                    "value": "E:\\ProgramData\\miniconda3\\envs\\torch2_env"
                },
                // Python cnn_predict_module.py
                {
                    "name": "PYTHONPATH",
                    "value": "E:/2CODE/AaaaaIi/4FireFDS/2firePDE/4Back"
                }
            ],
      "console": "integratedTerminal",
      "symbolSearchPath": "${workspaceFolder}\\Build\\impi_intel_win_db",

      "logging": {
        "moduleLoad": true
      }
    },
    {

      "name": "FDS-6.10 Release (Run Fast)",
