{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FDS-6.10 Debug",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\Build\\impi_intel_win_db\\fds_impi_intel_win_db.exe",
      "args": ["E:/2EXAMPLE/2EXAMPLEFDS/TTTs/simpletes/simple_test.fds"],
      "stopAtEntry": false,
      "cwd": "E:/2EXAMPLE/2EXAMPLEFDS/TTTs/simpletes",
      "console": "integratedTerminal",
      "symbolSearchPath": "${workspaceFolder}\\Build\\impi_intel_win_db",
      "sourceFileMap": {
          "E:\\CODE\\FDS\\fds\\Source": "E:\\2CODE\\FDS\\fds\\Source"
      },
      "logging": {
        "moduleLoad": true
      }
    },
    {
      "name": "FDS-6.10 Release (Run Fast)",
      "type": "cppvsdbg",
      "request": "launch",
      // 这里将路径指向了没有 _db 后缀的 release 文件夹和 exe
      "program": "${workspaceFolder}\\Build\\impi_intel_win\\fds_impi_intel_win.exe",
      "args": ["E:/2EXAMPLE/2EXAMPLEFDS/TTTs/simpletes/simple_test.fds"],
      "stopAtEntry": false,
      "cwd": "E:/2EXAMPLE/2EXAMPLEFDS/TTTs/simpletes",
      "console": "integratedTerminal"
      // 去掉 symbolSearchPath 和 sourceFileMap，因为 Release 版本通常不用于断点调试
    }
  ]
}